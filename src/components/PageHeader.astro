---
import { getMenu, getSiteSettings } from "emdash";

import { resolveStarterSiteIdentity } from "../utils/site-identity";
const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);
const menu = await getMenu("primary");
---

<header>
	<div class="layout">
		<div class="site-logo">
			<a href="/">
				{
					siteLogo ? (
						<img
							src={siteLogo.url}
							alt={siteLogo.alt || siteTitle}
							style="height:48px;width:auto;margin:-8px 0;display:block;"
						/>
					) : (
						siteTitle
					)
				}
			</a>
			{siteTagline}
		</div>
		<nav>
			<ul>
				{
					menu?.items.map((item) => {
						const href = item.url;
						return (
						<li class:list={item.cssClasses}>
							<a
								href={item.url}
								target={item.target}
								aria-current={
									Astro.url.pathname === href
										? "page"
										: undefined
								}
							>
								{item.label}
							</a>
						</li>
						);
					})
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	header {
		padding: 1rem 0 0;
		background-color: var(--text-highlight);
		color: var(--bg-primary);
		position: fixed;
		top: 0;
		width: 100%;
		height: var(--header-height);
	}
	.layout {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.site-logo {
		a {
			text-decoration: none;
			font-size: 3rem;
			font-weight: 800;
			justify-content: center;
			color: #fff;
			display: block;
			transition: 0.5s;
			margin: 0;
			&:hover {
				transform: scale(1.05);
			}
		}
	}
	nav {
		align-items: center;
		height: 100%;
		ul {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			gap: 1rem;
			a {
				display: inline-block;
				text-decoration: none;
				color: #fff;
				text-transform: uppercase;
				font-size: 1.2rem;
			}
		}
	}
</style>
