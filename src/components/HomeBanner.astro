---
import { Image } from "emdash/ui";

const { headline, subheader, heroImage, ctaUrl, cta } = Astro.props;
---

<section class="home-header">
    <div class="layout">
        <Image image={heroImage} width={800} height={450} />
        <header transition:animate="slide">
            <h1>{headline}</h1>
            <h2>{subheader}</h2>
            {
                cta && (
                    <a href={ctaUrl} class="cta">
                        {cta}
                    </a>
                )
            }
        </header>
    </div>
</section>

<style>
    .home-header {
        background: #000;
        padding: 5rem 0;
        text-align: right;
        position: relative;
        overflow: hidden;
        img {
            position: absolute;
            top: 0;
            left: 0;
            transform: translate(-0%, -0%);
            min-width: 100%;
            min-height: 100%;
        }
        header {
            background: var(--text-highlight);
            text-align: left;
            display: inline-block;
            color: #fff;
            padding: 3rem;
            width: calc(50%);
            -webkit-box-shadow:
                0px 10px 13px -7px #000000,
                5px 5px 15px 5px rgba(255, 255, 255, 0);
            box-shadow:
                0px 10px 13px -7px #000000,
                5px 5px 15px 5px rgba(255, 255, 255, 0);
            h1 {
                margin: 0;
                font-size: 4rem;
            }
            h2 {
                font-family: "Lexend", sans-serif;
                font-weight: 300;
            }
            a.cta {
                display: inline-block;
                background: var(--bg-primary);
                border: 1px solid #000;
                padding: 1rem;
                text-decoration: none;
                font-weight: 800;
                color: #000;
                transform: rotate(5deg) translateY(1rem) scale(1);
                transition: all .5s;
                font-family: "Life Savers", sans-serif;
                -webkit-box-shadow:
                    0px 10px 13px -7px #000000,
                    5px 5px 15px 5px rgba(255, 255, 255, 0);
                box-shadow:
                    0px 10px 13px -7px #000000,
                    5px 5px 15px 5px rgba(255, 255, 255, 0);
                &:hover {
                    transform: rotate(5deg) translateY(1rem) scale(1.2);
                }
            }
        }
    }
</style>
