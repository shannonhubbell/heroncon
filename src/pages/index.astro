---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import PageDefault from "../layouts/PageDefault.astro";
import PageHome from "../layouts/PageHome.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

if (!page) {
	return Astro.redirect("/404");
}

const layouts = new Map([
	["Default", PageDefault],
	["Home", PageHome],
]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const Layout = layouts.get(page.data.template ?? "") ?? PageDefault;
---

<Layout page={page} />
