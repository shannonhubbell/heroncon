---
import type { ContentEntry, InferCollectionData } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "./Base.astro";
import HomeBanner from "../components/HomeBanner.astro";
import FeaturedSpeakers from "../components/FeaturedSpeakers.astro";

interface Props {
  page: ContentEntry<InferCollectionData<"pages">>;
}

const { page } = Astro.props;
---

<HomeBanner
  headline="Waiting around is for the birds!"
  subheader="HeronCon 2026 is hitting Oakland, California!"
  cta="Register now!"
  ctaUrl="/registration"
  heroImage={page.data.hero_image}
/>
<Base title={page.data.title}>
  <section id="home-columns">
    <div class="welcome"><PortableText value={page.data.content} /></div>
    <div><FeaturedSpeakers /></div>
    <div></div>
  </section>
</Base>

<style>
  .page-default {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0;
  }
  #home-columns {
    display: flex;
    justify-content: space-between;
    > div {
      width: 30%;
      padding: 2rem 0;
    }
    h2 {
      font-size: 2.5rem;
      margin: 1rem 0;
    }
    .welcome {
      p {
        font-size: 1.2rem;
        line-height: 1.8rem;
      }
    }
  }
</style>
