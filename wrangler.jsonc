{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "heroncon2026",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "heroncon2026",
			"migrations_dir": "../../../../migrations",
			"database_id": "3eb92ac2-afe1-4d4b-a81d-1d5d73777e51",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "heroncon2026",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}